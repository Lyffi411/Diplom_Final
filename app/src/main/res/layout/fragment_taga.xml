<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background_dark" 
    android:padding="16dp" 
    tools:context=".ui.Silomer.Rasshet.TagaFragment">

    <!-- Поле ввода веса штанги -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayoutWeight_taga"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="Введите вес штанги (кг)"
        android:textColorHint="#9AA0A6"
        app:boxStrokeColor="#FFAB00"
        app:hintTextColor="#FFAB00"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editWheit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textColor="#E8EAED"
            android:backgroundTint="#2C2D30"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Поле ввода повторений -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayoutReps_taga"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Введите количество повторений"
        android:textColorHint="#9AA0A6"
        app:boxStrokeColor="#FFAB00"
        app:hintTextColor="#FFAB00"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textInputLayoutWeight_taga">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editKolvo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:digits="0123456789"
            android:textColor="#E8EAED"
            android:backgroundTint="#2C2D30"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Кнопка "Рассчитать" -->
    <Button
        android:id="@+id/button_rasshet" 
        style="@style/Widget.App.Button" 
        android:layout_width="0dp" 
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Рассчитать"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textInputLayoutReps_taga" />

    <!-- Прогресс-круг -->
    <com.example.diplom_final.ui.Silomer.Rasshet.ProgressCircleView
        android:id="@+id/progressCircle"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="32dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button_rasshet"
        tools:visibility="visible" />

    <!-- Текст результата -->
    <TextView
        android:id="@+id/textRes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Результат: 0 кг"
        android:textColor="@color/app_primary_orange" 
        android:textSize="28sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/progressCircle"
        app:layout_constraintEnd_toEndOf="@id/progressCircle"
        app:layout_constraintStart_toStartOf="@id/progressCircle"
        tools:visibility="visible"/>

    <!-- Кнопка "Показать варианты" -->
    <Button
        android:id="@+id/btnShowPercentages"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Доп рассчеты"
        android:textColor="#1E1E1E"
        app:strokeColor="@color/app_primary_orange"
        app:cornerRadius="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textRes"
        tools:visibility="visible"/>

    <!-- Кнопка "Сохранить результат" -->
    <Button
        android:id="@+id/btnSaveResult"
        style="@style/Widget.App.Button" 
        android:layout_width="wrap_content" 
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Сохранить результат"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/btnShowPercentages"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible"/>

</androidx.constraintlayout.widget.ConstraintLayout>