<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. Техника выполнения (ЗАГЛУШКА) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Техника выполнения"
                    android:textColor="@color/primary"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <!-- Жим лежа -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Жим лежа"
                    android:textColor="@color/on_background"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="1. Исходное положение"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Лягте на скамью, сведите лопатки\n• Стопы плотно прижаты к полу\n• Естественный прогиб в пояснице"
                    android:textColor="@color/on_surface"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="2. Хват и снятие штанги"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Возьмитесь за гриф хватом чуть шире плеч\n• Снимите штангу со стоек и зафиксируйте над грудью"
                    android:textColor="@color/on_surface"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="3. Опускание и жим"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Плавно опустите штангу на нижнюю часть груди\n• Мощно выжмите штангу вверх по той же траектории"
                    android:textColor="@color/on_surface"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Основные моменты (Жим лежа)"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Локти двигаются под углом примерно 45° к телу\n• Держите лопатки сведенными\n• Не отрывайте таз от скамьи"
                    android:textColor="@color/on_surface"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"/>

                <!-- Техника безопасности (Общая) -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Техника безопасности (Общая)"
                    android:textColor="@color/on_background"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="⚠️ Всегда выполняйте разминку\n⚠️ Начинайте с легких весов для отработки техники\n⚠️ Не делайте резких рывков\n⚠️ Используйте страховку при жиме лежа"
                    android:textColor="@color/warning"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Калькулятор нормативов -->
        <com.google.android.material.card.MaterialCardView
