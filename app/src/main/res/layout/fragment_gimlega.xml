<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. Техника выполнения (Жим лежа) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Техника выполнения (Жим лежа)"
                    android:textColor="@color/primary"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="1. Исходное положение"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Лежа на скамье, ноги твердо на полу\n• Хват грифа чуть шире плеч\n• Плечи и ягодицы плотно прижаты к скамье"
                    android:textColor="@color/on_surface"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="2. Техника выполнения"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Снять штангу со стоек\n• Опустить к середине груди\n• Без отскока поднять штангу до полного выпрямления рук\n• Поставить гриф на стойки"
                    android:textColor="@color/on_surface"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Основные моменты"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Сохраняйте стабильное положение на протяжении всего упражнения\n• Держите запястья прямыми\n• Пауза на груди без отскока\n• Не отрывайте голову, плечи и таз от скамьи"
                    android:textColor="@color/on_surface"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="4dp"/>

                 <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Техника безопасности"
                    android:textColor="@color/on_background"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                 <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="⚠️ Всегда используйте страховщика при тяжелых весах\n⚠️ Убедитесь, что замки на грифе надежно закреплены\n⚠️ Не отбивайте гриф от груди\n⚠️ Не допускайте прогиба поясницы"
                    android:textColor="@color/warning"/>
            </LinearLayout>
