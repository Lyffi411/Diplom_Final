<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Секция 1: Общая информация -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Жим лёжа с однослойной экипировкой"
                    android:textColor="@color/primary"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Особенности дивизиона"
                    android:textColor="@color/primary"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="• Разрешается использовать однослойные софт-экипировки (однослойная майка)\n• Соревнования проводятся по версиям WPC и AWPC\n• Экипировка даёт преимущество в 5-15% по сравнению с RAW"
                    android:textColor="@color/on_surface"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Требования к экипировке"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="• Майка должна быть однослойной\n• Все швы и края должны быть фабричными\n• Не разрешается дополнительное усиление\n• Необходим допуск судьи для подтверждения соответствия"
                    android:textColor="@color/on_surface"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Техника жима с однослойной экипировкой"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="• Укладка на скамью такая же, как в обычном жиме\n• Траектория может быть немного изменена из-за экипировки\n• Важно нарабатывать технику с учетом особенностей майки\n• Может понадобиться помощь для правильного надевания"
                    android:textColor="@color/on_surface"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Рекомендации"
                    android:textColor="@color/warning"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="⚠️ Тренируйтесь периодически и без экипировки\n⚠️ Подбирайте размер майки в соответствии с рекомендациями производителя\n⚠️ Всегда имейте страховщиков при работе с весами в экипировке"
                    android:textColor="@color/warning"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Секция 2: Калькулятор нормативов -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Рассчет норматива (жим в однослойной)"
                    android:textColor="@color/primary"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    style="@style/Widget.App.TextInputLayout"
                    android:hint="Ваш вес (кг)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/weightInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/on_surface"/>
                </com.google.android.material.textfield.TextInputLayout>
                <Button
                    android:id="@+id/calculateButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Рассчитать"
                    style="@style/Widget.App.Button"/>
                <TextView
                    android:id="@+id/resultText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/on_surface"
                    android:textSize="16sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Секция 3: Сравнение результатов (между RAW и однослойной экипировкой) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Сравнение результатов"
                    android:textColor="@color/primary"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    style="@style/Widget.App.TextInputLayout"
                    android:hint="Ваш результат в RAW (кг)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/rawResultInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/on_surface"/>
                </com.google.android.material.textfield.TextInputLayout>
                
                <Button
                    android:id="@+id/compareButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Сравнить"
                    style="@style/Widget.App.Button"/>
                
                <TextView
                    android:id="@+id/comparisonResultText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/on_surface"
                    android:textSize="16sp"/>
                
                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/comparisonChart"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="16dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Секция 4: Рекомендации по тренировкам -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Программы тренировок"
                    android:textColor="@color/primary"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/trainingTipsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Секция 5: Рекомендуемые модели однослойных маек -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Рекомендуемая экипировка"
                    android:textColor="@color/primary"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/equipmentRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Секция 6: Таблица нормативов (однослойная экипировка) -->
        <LinearLayout
            android:id="@+id/zoomContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Мужчины -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Мужчины - жим лёжа (однослойная)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="16dp"
                android:textColor="@color/primary"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TableLayout
                    android:id="@+id/tableMen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*">
                    <TableRow android:background="@drawable/header_border">
                        <TextView style="@style/TableHeader" android:text="Весовая" />
                        <TextView style="@style/TableHeader" android:text="МСМК (ДК)" />
                        <TextView style="@style/TableHeader" android:text="МС (ДК)" />
                        <TextView style="@style/TableHeader" android:text="МСМК" />
                        <TextView style="@style/TableHeader" android:text="МС" />
                        <TextView style="@style/TableHeader" android:text="КМС" />
                        <TextView style="@style/TableHeader" android:text="I" />
                        <TextView style="@style/TableHeader" android:text="II" />
                        <TextView style="@style/TableHeader" android:text="III" />
                    </TableRow>
                    <!-- Нормативы жима лежа с однослойной для мужчин будут добавлены динамически -->
                </TableLayout>
            </HorizontalScrollView>

            <!-- Женщины -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Женщины - жим лёжа (однослойная)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="16dp"
                android:layout_marginTop="24dp"
                android:textColor="@color/primary"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TableLayout
                    android:id="@+id/tableWomen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*">
                    <TableRow android:background="@drawable/header_border">
                        <TextView style="@style/TableHeader" android:text="Весовая" />
                        <TextView style="@style/TableHeader" android:text="МСМК (ДК)" />
                        <TextView style="@style/TableHeader" android:text="МС (ДК)" />
                        <TextView style="@style/TableHeader" android:text="МСМК" />
                        <TextView style="@style/TableHeader" android:text="МС" />
                        <TextView style="@style/TableHeader" android:text="КМС" />
                        <TextView style="@style/TableHeader" android:text="I" />
                        <TextView style="@style/TableHeader" android:text="II" />
                        <TextView style="@style/TableHeader" android:text="III" />
                    </TableRow>
                    <!-- Нормативы жима лежа с однослойной для женщин будут добавлены динамически -->
                </TableLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>