<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 1. Общая информация о двоеборье -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Двоеборье"
                    android:textColor="@color/primary"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Что такое двоеборье?"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Двоеборье в пауэрлифтинге включает в себя два упражнения: жим лежа и становую тягу. Результаты суммируются, и победитель определяется по наибольшей сумме поднятых весов. Это популярная дисциплина для тех, кто не хочет выполнять приседания со штангой."
                    android:textColor="@color/on_surface"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Правила соревнований"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="• Сначала выполняются все подходы в жиме лежа\n• После перерыва выполняются все подходы в становой тяге\n• По три соревновательных попытки в каждом упражнении\n• Лучший результат в каждом упражнении идет в сумму\n• Технические требования к упражнениям идентичны классическому пауэрлифтингу"
                    android:textColor="@color/on_surface"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Преимущества двоеборья"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="• Подходит для спортсменов с ограничениями в приседаниях\n• Меньше нагрузка на колени и голеностопные суставы\n• Более короткие соревнования\n• Быстрее восстановление после соревнований\n• Возможность показывать более высокие результаты в двух упражнениях благодаря сниженной усталости"
                    android:textColor="@color/on_surface"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Техника безопасности"
                    android:textColor="@color/on_background"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="⚠️ Тщательно разминайтесь перед каждым упражнением\n⚠️ Используйте страховку при жиме лежа\n⚠️ Соблюдайте правильную технику в становой тяге для защиты спины\n⚠️ Правильно планируйте веса между упражнениями"
                    android:textColor="@color/warning"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Калькулятор нормативов -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Рассчет норматива (двоеборье)"
                    android:textColor="@color/primary"
                    android:textSize="20sp"
                    android:textStyle="bold"/>
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    style="@style/Widget.App.TextInputLayout"
                    android:hint="Ваш вес (кг)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/weightInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/on_surface"/>
                </com.google.android.material.textfield.TextInputLayout>
                
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/Widget.App.TextInputLayout"
                    android:hint="Жим лежа (кг)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/benchInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/on_surface"/>
                </com.google.android.material.textfield.TextInputLayout>
                
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    style="@style/Widget.App.TextInputLayout"
                    android:hint="Становая тяга (кг)">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/deadliftInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal"
                        android:textColor="@color/on_surface"/>
                </com.google.android.material.textfield.TextInputLayout>
                
                <Button
                    android:id="@+id/calculateButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Рассчитать"
                    style="@style/Widget.App.Button"/>
                    
                <TextView
                    android:id="@+id/resultText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textColor="@color/on_surface"
                    android:textSize="16sp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Статистика по возрастным группам -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Статистика по возрастным группам"
                    android:textColor="@color/primary"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/ageStatsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. Рекомендации по тренировкам -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Программы тренировок"
                    android:textColor="@color/primary"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/trainingTipsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. График прогресса -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ваш прогресс"
                    android:textColor="@color/primary"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/progressTrackingChart"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="8dp"/>
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">
                    <Button
                        android:id="@+id/btnViewBench"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Жим лежа"
                        android:layout_marginEnd="8dp"
                        style="@style/Widget.App.Button"/>
                    <Button
                        android:id="@+id/btnViewDeadlift"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Становая тяга"
                        android:layout_marginStart="8dp"
                        style="@style/Widget.App.Button"/>
                </LinearLayout>
                
                <Button
                    android:id="@+id/btnViewTotal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Общая сумма"
                    style="@style/Widget.App.Button"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 6. Цели и прогресс -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Цели и прогресс"
                    android:textColor="@color/primary"
                    android:textSize="18sp"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/targetInfoText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/on_surface"/>
                <Button
                    android:id="@+id/addProgressButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Добавить результат"
                    style="@style/Widget.App.Button"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 7. Таблицы нормативов для двоеборья -->
        <LinearLayout
            android:id="@+id/zoomContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Мужчины -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Мужчины - Нормативы двоеборья"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="16dp"
                android:textColor="@color/primary"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TableLayout
                    android:id="@+id/tableMen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*">
                    <TableRow android:background="@drawable/header_border">
                        <TextView style="@style/TableHeader" android:text="Весовая" />
                        <TextView style="@style/TableHeader" android:text="МСМК" />
                        <TextView style="@style/TableHeader" android:text="МС" />
                        <TextView style="@style/TableHeader" android:text="КМС" />
                        <TextView style="@style/TableHeader" android:text="I" />
                        <TextView style="@style/TableHeader" android:text="II" />
                        <TextView style="@style/TableHeader" android:text="III" />
                    </TableRow>
                    <!-- Данные будут подгружаться динамически -->
                </TableLayout>
            </HorizontalScrollView>

            <!-- Женщины -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Женщины - Нормативы двоеборья"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center"
                android:padding="16dp"
                android:layout_marginTop="24dp"
                android:textColor="@color/primary"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TableLayout
                    android:id="@+id/tableWomen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:stretchColumns="*">
                    <TableRow android:background="@drawable/header_border">
                        <TextView style="@style/TableHeader" android:text="Весовая" />
                        <TextView style="@style/TableHeader" android:text="МСМК" />
                        <TextView style="@style/TableHeader" android:text="МС" />
                        <TextView style="@style/TableHeader" android:text="КМС" />
                        <TextView style="@style/TableHeader" android:text="I" />
                        <TextView style="@style/TableHeader" android:text="II" />
                        <TextView style="@style/TableHeader" android:text="III" />
                    </TableRow>
                    <!-- Данные будут подгружаться динамически -->
                </TableLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
